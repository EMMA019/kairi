# Copy to .env (or backend/.env) and fill in what you use.
# Never commit real keys.

# --- LLM (BYOK; at least one) ---
# Free tiers (no credit card): Gemini or Groq
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Paid / cheap: DeepSeek
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Search (optional) ---
BRAVE_API_KEY=

# --- Safety / ops ---
# KAIRI_API_TOKEN=
# KAIRI_ENABLE_SCHEDULERS=0
# KAIRI_RELEASE=0

# --- Own-channel promo (draft → approve → post; never replies to others) ---
# DISCORD_WEBHOOK_URL=
# KAIRI_PROMO_ENABLED=0
# KAIRI_PROMO_AUTO_POST=0
# KAIRI_PROMO_DISCORD=1
# KAIRI_PROMO_GITHUB=0
# KAIRI_PROMO_DAILY_CAP=1
# KAIRI_PROMO_GITHUB_REPO=          # owner/name of YOUR repo
# KAIRI_PROMO_GITHUB_TOKEN=
# KAIRI_PROMO_DISCLOSE_BOT=1
# KAIRI_SUPERVISOR_SKIP=1

# --- Workspace persistence on GitHub (survives Render disk wipes) ---
# Create an empty repo first, e.g. you/kairi-portfolio
# KAIRI_WORKSPACE_GITHUB_REPO=
# KAIRI_WORKSPACE_GITHUB_BRANCH=main
# KAIRI_WORKSPACE_GITHUB_TOKEN=     # or reuse KAIRI_PROMO_GITHUB_TOKEN / settings github_token

# --- Key-free demo (grounding pipeline only; no LLM) ---
# KAIRI_DEMO=1
