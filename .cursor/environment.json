{
  "name": "Kairi",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && KAIRI_DEMO=1 KAIRI_ENABLE_SCHEDULERS=0 .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 127.0.0.1 --port 5173"
    }
  ],
  "ports": [8000, 5173]
}
